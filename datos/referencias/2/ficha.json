 "segmentos": [
  {
   "s": 0.0,
   "e": 4.76,
   "texto": "This editing style is taking over in 2026 and every single editor wants to learn it."
  },
  {
   "s": 4.94,
   "e": 6.84,
   "texto": "So here's a quick breakdown of how it's made."
  },
  {
   "s": 7.1,
   "e": 9.44,
   "texto": "There's really three steps to making this editing style."
  },
  {
   "s": 9.82,
   "e": 10.78,
   "texto": "First is the background."
  },
  {
   "s": 11.04,
   "e": 13.94,
   "texto": "The background is typically white, layered on with a grid effect."
  },
  {
   "s": 14.3,
   "e": 17.78,
   "texto": "It also has a half-told texture and even a casted shadow."
  },
  {
   "s": 18.08,
   "e": 19.76,
   "texto": "The second step is your main object."
  },
  {
   "s": 20.14,
   "e": 22.08,
   "texto": "There are two types of scenes in this editing style."
  },
  {
   "s": 22.36,
   "e": 23.98,
   "texto": "Object centric and text centric."
  },
  {
   "s": 24.14,
   "e": 26.12,
   "texto": "Just take your main object and place it in the middle."
  },
  {
   "s": 26.12,
   "e": 29.9,
   "texto": "Then stylize it with desaturation, a texture and a casted shadow."
  },
  {
   "s": 30.14,
   "e": 32.16,
   "texto": "The third step is your complementary object."
  },
  {
   "s": 32.52,
   "e": 36.3,
   "texto": "This is the text that comes behind or around your object to help visualize it."
  },
  {
   "s": 36.5,
   "e": 38.12,
   "texto": "And finally, it's your depth elements."
  },
  {
   "s": 38.56,
   "e": 41.94,
   "texto": "These are the elements on the edges of the screen with a blur and a darken effect"
  },
  {
   "s": 41.94,
   "e": 43.04,
   "texto": "to give you some depth."
  },
  {
   "s": 43.3,
   "e": 46.7,
   "texto": "If you would like to watch me create this scene over here step by step,"
  },
  {
   "s": 46.88,
   "e": 48.94,
   "texto": "I've made a full tutorial breaking it down on YouTube."
  },
  {
   "s": 49.22,
   "e": 50.12,
   "texto": "Just go ahead and check it out."
  }
 ]
}