 "segmentos": [
  {
   "s": 0.0,
   "e": 2.2,
   "texto": "If you're in real estate media doing over 10k a month"
  },
  {
   "s": 2.2,
   "e": 4.36,
   "texto": "and the whole thing stops the second you stop shooting,"
  },
  {
   "s": 4.5,
   "e": 5.96,
   "texto": "I've been in your exact position."
  },
  {
   "s": 6.34,
   "e": 7.96,
   "texto": "My position was flying around the country"
  },
  {
   "s": 7.96,
